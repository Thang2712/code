#include <stdio.h> 
#include <stdbool.h>
#include <stdlib.h> 


int compare(const void *a, const void *b)
{
    return (*(int*)a - *(int*)b);
}


bool containsDuplicate(int* nums, int numSize)
{
    qsort(nums, numSize, sizeof(int), compare);

    int i; 
    for (i = 1; i < numSize; i++)
        if (nums[i] == nums[i - 1])
            return true;
    return false;
}

